{
  "name": "businessverse",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "build": "bun run --filter @businessverse/web build",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test tests",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "setup": "bun scripts/setup-local.ts",
    "format": "prettier --write apps tests scripts docs package.json docker-compose.yml",
    "test:integration": "docker compose run --rm --no-deps -e RUN_INTEGRATION=1 -v \"$PWD/tests:/app/tests:ro\" api bun test /app/tests",
    "test:postman": "bun scripts/run-postman.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
