POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
APP_URL=http://localhost:8080
WEB_PORT=8080
# Local development only (Docker sets this automatically):
DATABASE_URL=postgres://businessverse:replace-with-a-long-random-password@localhost:5437/businessverse
# Cloudflare Tunnel (optional): set COMPOSE_PROFILES=tunnel and paste the token from `cloudflared tunnel token <name>`
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
