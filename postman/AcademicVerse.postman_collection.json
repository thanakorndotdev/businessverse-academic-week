{
  "info": {
    "name": "AcademicVerse — game rules and access control",
    "description": "Run ONLY against a fresh disposable businessverse_test service. This suite creates team 1 with an access code and opens the first gate. Set organizer credentials in your local environment; never commit them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON response',()=>pm.response.to.be.json);",
              "pm.test('Database connected',()=>pm.expect(pm.response.json().db).to.eql('connected')); "
            ]
          }
        }
      ]
    },
    {
      "name": "Organizer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{admin_email}}\",\"password\":\"{{admin_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON response',()=>pm.response.to.be.json);",
              "pm.environment.set('admin_token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Organizer creates team 1 with an access code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/api/admin/teams/generate",
        "body": {
          "mode": "raw",
          "raw": "{\"count\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON response',()=>pm.response.to.be.json);",
              "const t=pm.response.json().participants.find(p=>p.teamNumber===1);pm.environment.set('team_code',t.accessCode);pm.test('Code issued',()=>pm.expect(t.accessCode).to.match(/^[A-Z2-9]{6}$/));pm.test('Target assigned',()=>pm.expect(t.objective.id).to.be.oneOf(['growth','premium','cost','customer']));"
            ]
          }
        }
      ]
    },
