    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting action or keep-presenting choice.",
      "html": "<button class=\"ds-button-secondary\">แสดงต่อ</button>",
      "css": ".ds-button-secondary{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:13px;min-height:46px;padding:12px 20px;border:0;border-radius:7px;background:#eaf0e8;color:#214238;font-size:12px;font-weight:600;line-height:1.5;cursor:pointer;transition:background .18s,transform .18s;}.ds-button-secondary:hover:not(:disabled){transform:translateY(-1px);}.ds-button-secondary:focus-visible{outline:3px solid #bd8225;outline-offset:5px;}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native labeled input with visible keyboard focus.",
      "html": "<label class=\"ds-field\">ชื่อผู้เข้าร่วม<input class=\"ds-input\" placeholder=\"ชื่อของคุณ\" autocomplete=\"name\"></label>",
      "css": ".ds-field{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);display:grid;gap:8px;font-size:12px;color:var(--ink,#173540);}.ds-input{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);min-height:46px;border:1px solid #c9d3cc;border-radius:8px;background:#fff;padding:10px 13px;width:100%;color:var(--ink,#173540);}.ds-input::placeholder{color:#73817d;}.ds-input:focus-visible{outline:2px solid #32746d;outline-offset:2px;}"
    },
    {
      "name": "Marine Navigation",
      "kind": "nav",
      "description": "Desktop route link with icon, gold active treatment and lighter marine hover.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#main\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m16 8-3 5-5 3 3-5Z\"/></svg>สนามธุรกิจ</a><a href=\"#passport\">พาสปอร์ตของฉัน</a></nav>",
      "css": ".ds-nav{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);display:flex;flex-direction:column;gap:6px;background:var(--navy,#173540);padding:20px;max-width:226px;}.ds-nav a{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:8px;color:#c0d0cc;font-weight:500;font-size:13px;text-decoration:none;transition:background .18s,color .18s;}.ds-nav a:hover{background:#25434b;color:#fff;}.ds-nav a[aria-current]{background:#2c464b;color:#ffe09b;}.ds-nav a[aria-current] svg{color:var(--gold,#eac15c);}.ds-nav a:focus-visible{outline:3px solid #bd8225;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
    },
    {
      "name": "Live Status Badge",
      "kind": "chip",
      "refersTo": "status-live",
      "description": "Read-only availability badge; status is conveyed with text and dot.",
      "html": "<span class=\"ds-status\"><i aria-hidden=\"true\"></i>เปิดแล้ว</span>",
      "css": ".ds-status{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:4px 7px;border-radius:4px;font-size:8px;font-weight:500;line-height:1.5;white-space:nowrap;background:#dfede1;color:#326348;}.ds-status i{width:5px;height:5px;background:#367151;border-radius:50%;}"
    },
    {
      "name": "Discipline Card",
      "kind": "card",
      "refersTo": "department-card",
      "description": "Whole-card link with category line art, heading, status and progress. Preview uses the Marketing tone.",
      "html": "<a class=\"ds-card\" href=\"#marketing\"><div class=\"ds-art\"><span class=\"ds-number\">02</span><span class=\"ds-rings\"></span><svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M3 8h5l12-4v16L8 16H3ZM8 16l2 6H6l-2-6M8 8v8\"/></svg><span class=\"ds-card-status\">รอเริ่มภารกิจ</span></div><div class=\"ds-card-body\"><h3>การตลาด</h3><span class=\"ds-card-english\">MARKETING</span><p>เข้าใจลูกค้า สร้างคุณค่าให้ธุรกิจ</p><div class=\"ds-card-bottom\"><span class=\"ds-mini\"><i></i><i></i><i></i><span>0 / 3</span></span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></div></div></a>",
      "css": ".ds-card{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);display:block;max-width:250px;background:#fff;color:var(--ink,#173540);border-radius:12px;overflow:hidden;text-decoration:none;transition:transform .2s,box-shadow .2s;}.ds-card:hover{transform:translateY(-4px);box-shadow:0 9px 25px #17354010;}.ds-card:focus-visible{outline:3px solid #bd8225;outline-offset:5px;}.ds-art{height:109px;background:#e5eadf;color:#527057;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;}.ds-art svg{position:relative;}.ds-number{position:absolute;top:12px;left:15px;font-size:11px;opacity:.8;}.ds-rings{position:absolute;width:147px;height:147px;border:1px solid currentColor;border-radius:50%;opacity:.13;top:-19px;}.ds-rings:before,.ds-rings:after{content:\"\";position:absolute;border:1px solid currentColor;border-radius:50%;}.ds-rings:before{inset:21px;}.ds-rings:after{inset:-22px;}.ds-card-status{position:absolute;bottom:10px;right:10px;background:#ffffffdf;color:#53604e;font-size:8px;padding:4px 7px;border-radius:4px;}.ds-card-body{padding:16px 17px 14px;}.ds-card-body h3{margin:0;font-size:15px;font-weight:600;line-height:1.35;letter-spacing:-.025em;}.ds-card-english{display:block;margin-top:6px;color:#64736b;font-size:8px;letter-spacing:.08em;line-height:1.5;font-weight:500;}.ds-card-body p{font-size:10px;color:var(--muted,#607176);line-height:1.7;margin:6px 0 0;min-height:34px;}.ds-card-bottom{border-top:1px solid #edf0e8;padding-top:13px;margin-top:14px;display:flex;align-items:center;justify-content:space-between;}.ds-mini{display:flex;align-items:center;gap:3px;}.ds-mini i{height:4px;width:10px;border-radius:2px;background:#e0e6db;}.ds-mini span{font-size:8px;color:#687963;margin-left:5px;}@media(prefers-reduced-motion:reduce){.ds-card{transition:none;}}"
    },
    {
      "name": "Answer Selection",
      "kind": "custom",
      "refersTo": "answer-selected",
      "description": "Native radio label with selected surface and focus on the full wrapper.",
      "html": "<fieldset class=\"ds-answers\"><legend>เลือกคำตอบ</legend><label class=\"ds-answer\"><input type=\"radio\" name=\"ds-choice\" checked><span class=\"ds-letter\">A</span><span class=\"ds-answer-copy\"><strong>พิจารณาเป้าหมายของทีม</strong><span>ดูผลต่อธุรกิจก่อนตัดสินใจ</span></span><span class=\"ds-answer-check\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></label><label class=\"ds-answer\"><input type=\"radio\" name=\"ds-choice\"><span class=\"ds-letter\">B</span><span class=\"ds-answer-copy\"><strong>พิจารณาผลระยะสั้น</strong><span>เปรียบเทียบกับสถานะธุรกิจปัจจุบัน</span></span><span class=\"ds-answer-check\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></label></fieldset>",
      "css": ".ds-answers{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;color:var(--ink,#173540);}.ds-answers legend{font-size:12px;margin-bottom:10px;}.ds-answer{border:1px solid #dce2d5;border-radius:9px;padding:17px 14px;display:flex;gap:11px;align-items:flex-start;position:relative;cursor:pointer;transition:background .15s,border-color .15s;}.ds-answer:hover{background:#f6f8f1;}.ds-answer:has(input:checked){border-color:#487159;background:#f0f5e9;}.ds-answer:has(input:focus-visible){outline:3px solid #bd8225;outline-offset:3px;}.ds-answer input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;margin:0;}.ds-letter{display:grid;place-items:center;min-width:26px;height:26px;background:#f1f3eb;border-radius:5px;font-size:10px;color:#647862;}.ds-answer:has(input:checked) .ds-letter{background:#dce8ce;color:#3c6344;}.ds-answer-copy{flex:1;}.ds-answer-copy strong{display:block;font-size:13px;line-height:1.5;}.ds-answer-copy>span{display:block;font-size:11px;line-height:1.7;color:var(--muted,#607176);margin-top:4px;}.ds-answer-check{height:17px;width:17px;border:1px solid #b9c5ad;border-radius:50%;display:grid;place-items:center;margin-top:4px;}.ds-answer-check svg{visibility:hidden;}.ds-answer:has(input:checked) .ds-answer-check{background:#406c47;color:#fff;border-color:#406c47;}.ds-answer:has(input:checked) .ds-answer-check svg{visibility:visible;}@media(prefers-reduced-motion:reduce){.ds-answer{transition:none;}}"
    },
    {
      "name": "Objective Context",
      "kind": "card",
      "refersTo": "mission-target",
      "description": "Persistent objective, criterion and explanatory copy. Content is example text, not a new game target.",
      "html": "<aside class=\"ds-target\"><h3>เป้าหมายธุรกิจของคุณ</h3><span>YOUR STRATEGIC TARGET</span><p>พิจารณาเป้าหมายและสถานะธุรกิจก่อนเลือก</p><strong>เกณฑ์เป้าหมายของทีมจะแสดงที่นี่</strong></aside>",
      "css": ".ds-target{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);max-width:248px;padding:25px;background:#e9ecde;border-radius:11px;color:var(--ink,#173540);}.ds-target h3{font-size:22px;line-height:1.2;letter-spacing:-.025em;font-weight:600;margin:0;}.ds-target>span{display:block;margin-top:10px;font-size:9px;letter-spacing:.03em;color:#697a55;}.ds-target p{font-size:11px;line-height:1.8;color:#61714d;margin:13px 0 0;}.ds-target strong{display:block;font-size:13px;font-weight:500;border-top:1px solid #ced7c0;margin-top:18px;padding-top:17px;line-height:1.6;}"
    },
    {
      "name": "Unlock Dialog Surface",
      "kind": "custom",
      "description": "Static native dialog preview; the application opens it modally and handles cancellation/confirmation.",
      "html": "<dialog open class=\"ds-dialog\" aria-labelledby=\"ds-unlock-title\"><h2 id=\"ds-unlock-title\">ออกจากจอพรีเซนต์?</h2><p>ยืนยันเพื่อกลับไปยังหน้าควบคุมการแข่งขัน</p><div><button class=\"ds-keep\">แสดงต่อ</button><button class=\"ds-confirm\">ยืนยันปลดล็อก</button></div></dialog>",
      "css": ".ds-dialog{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);position:relative;margin:0;border:0;width:min(460px,calc(100vw - 40px));padding:30px;color:var(--ink,#173540);background:#fff;border-radius:13px;}.ds-dialog::backdrop{background:#081d25bd;}.ds-dialog h2{font-size:24px;font-weight:600;line-height:1.35;letter-spacing:-.025em;margin:0;}.ds-dialog p{margin:14px 0 0;font-size:12px;line-height:1.8;color:var(--muted,#607176);}.ds-dialog>div{display:flex;gap:12px;margin-top:24px;}.ds-dialog button{font-family:var(--sans,\"Space Grotesk\",\"Noto Sans Thai\",sans-serif);min-height:46px;border:0;border-radius:7px;padding:12px 20px;font-size:12px;font-weight:600;line-height:1.5;cursor:pointer;transition:background .18s,transform .18s;}.ds-keep{background:#eaf0e8;color:#214238;}.ds-confirm{background:var(--navy,#173540);color:#fff;}.ds-dialog button:hover{transform:translateY(-1px);}.ds-confirm:hover{background:#264a52;}.ds-dialog button:focus-visible{outline:3px solid #bd8225;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-dialog button{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "The Academic Exhibition Guide",
    "overview": "Cream paper, deep marine wayfinding and warm UBS gold make the business challenge feel like a coherent university exhibition. Precise circular diagrams, numbered disciplines and passport stamps connect eight areas of study without requiring decorative scenery. The supplied UTCC Business School logo anchors the identity.\n\nThe interface serves participants making decisions on phones and organizers operating controls on desktops and a stage display. Keep the working surfaces calm, the next action explicit and progress visible. The source implementation is the authority when older screenshots differ.",
    "keyCharacteristics": [
      "Marine navigation and large compact display typography.",
      "Cream page canvas with white operational panels and muted discipline illustrations.",
      "A connected eight-node business diagram and circular completion stamps.",
      "Thai-first content with an English interface toggle.",
      "Visible objectives, business state and three-question progress."
    ],
    "rules": [
      {
        "name": "The Meaning Before Color Rule",
        "body": "Keep state names, counts and icons alongside color; a green tint alone does not explain progress or availability.",
        "section": "colors"
      },
      {
        "name": "The Heading First Rule",
        "body": "Put the meaningful Thai discipline or objective heading before its English name or descriptive metadata, following the current component order.",
        "section": "typography"
      },
      {
        "name": "The Context Before Choice Rule",
        "body": "Keep the current business objective, measurable target and business metrics ahead of the scenario on compact screens. Refresh target context with live target changes; do not make participants leave their decision to find it.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use surface color and spacing before adding elevation; keep shadows tied to the existing selection, hover or waiting treatments.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use marine for wayfinding, cream for the canvas and white for operational panels.",
      "**Do** preserve gold emphasis for brand, entry, completion and presentation hierarchy.",
      "**Do** keep Thai and English content legible within the shared self-hosted type stack.",
      "**Do** put objective, current business metrics and three-step progress within the decision flow.",
      "**Do** pair state color with labels, icons or counts and retain native input and dialog semantics.",
      "**Do** preserve reduced-motion behavior, visible focus and mobile navigation clearance."
    ],
    "donts": [
      "**Don't** promote tiny incumbent metadata or decorative uppercase captions into a required text style.",
      "**Don't** replace precise SVG diagrams and the supplied logo with invented scenery or glyph icons.",
      "**Don't** add heavy shadows to every panel or flatten distinct category colors into status colors.",
      "**Don't** expose organizer rankings in participant surfaces or fabricate scores for empty states.",
      "**Don't** infer contrast compliance or final screenshot fidelity from this documentation."
    ]
  }
}
